# Variables for the Komodo stack environment. For a local dry run: copy to .env (git-ignored) and fill in.
DOMAIN=internal

UNIFI_URL=https://10.31.1.1
UNIFI_USER=update-dns
UNIFI_PASS=

AG_URL=http://10.31.101.8
AG_USER=
AG_PASS=

# Read-only token, see README ("Proxmox token").
PVE_URL=https://10.31.100.11:8006
PVE_TOKEN_ID=update-dns@pve!dns
PVE_TOKEN_SECRET=
# PVE_VERIFY_TLS=false

# Optional
# NTFY_URL=https://ntfy.example/update-dns
# NTFY_TOKEN=
# GRACE_SECONDS=900          # how long a vanished name is kept
# MAX_REMOVALS=10            # max names that may vanish in one run
# INTERVAL=60
# INCLUDE_IPV6=true          # AAAA records: global addresses, ULA only if none (never link-local)
# VLAN_ORDER=services,default,admin,services-hetzner,privacy   # which VLAN keeps the plain name
# PVE_MAC_PREFIXES=bc:24:11
