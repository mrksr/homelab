#!/bin/sh

set -e

DISK_LOCATION=/var/lib/pve/local-btrfs

find "$DISK_LOCATION" -name '*.raw' ! -path '*vzdump*' | while read -r f; do
  if [ "$(btrfs property get "$f" compression)" != "compression=zstd" ]; then
    btrfs property set "$f" compression zstd
    ionice -c3 nice -n19 btrfs filesystem defrag -czstd "$f"
  fi
done
